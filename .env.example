# ==================== POLYMARKET API ====================
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_SECRET=your_polymarket_secret_here

# ==================== WALLET ====================
WALLET_PRIVATE_KEY=your_wallet_private_key_here
WALLET_ADDRESS=your_wallet_address_here

# ==================== WEATHER APIs ====================
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
WINDY_API_KEY=your_windy_api_key_here

# ==================== BOT SETTINGS ====================
CHECK_INTERVAL_MINUTES=15
MAX_INVESTMENT_PER_TRADE=10
MIN_LIQUIDITY=3000
MAX_PRICE_SUM=0.96

# ==================== RISK MANAGEMENT ====================
MAX_POSITION_SIZE=50
DAILY_LOSS_LIMIT=20
MAX_POSITIONS_PER_CITY=2
KELLY_CRITERION_FRACTION=0.5

# ==================== STRATEGY ====================
MIN_CONFIDENCE_SCORE=0.7
MIN_MODEL_CONSENSUS=0.8
TEMPERATURE_RANGE=1
ENABLE_ML_PREDICTIONS=false

# ==================== CITIES ====================
MONITORED_CITIES=New York,Los Angeles,Chicago,London,Paris,Tokyo

# ==================== FLASK ====================
FLASK_ENV=production
PORT=5000
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
